/**
 * 1. CARI / DAPATKAN DAFTAR
 * Mengambil daftar komik berdasarkan halaman atau kata kunci pencarian
 */
fungsi async pencarian(query = "", halaman = 1) {
  mencoba {
    misalkan url = `${BASE_URL}/page/${page}/`;
    jika (query && query.trim() !== "") {
      url = `${BASE_URL}/page/${page}/?s=${encodeURIComponent(query)}`;
    }

    const res = await fetch(url, { headers });
    const html = await res.text();

    let list = [];
    
    // Parser sederhana menggunakan regex untuk mengambil elemen komik dari HTML Doujindesu
    // Format umum: <div class="kan"> atau <article> yang memuat tag <a>, <img>, dan judul
    const articleRegex = /<article[^>]*>([\s\S]*?)<\/article>/gi;
    biarkan cocok;

    selama ((match = articleRegex.exec(html)) !== null) {
      const block = match[1];

      const linkMatch = block.match(/href="([^"]+)"/);
      const titleMatch = block.match(/title="([^"]+)"/) || block.match(/<h2[^>]*>([^<]+)<\/h2>/);
      const imgMatch = block.match(/src="([^"]+)"/) || block.match(/data-src="([^"]+)"/);

      jika (linkMatch && titleMatch) {
        const mangaUrl = linkMatch[1];
        // Ekstrak ID unik dari URL (misal: /manga/judul-komik/ -> judul-komik)
        const idMatch = mangaUrl.match(/\/manga\/([^/]+)/) || mangaUrl.match(/.tv\/([^/]+)/);
        const id = idMatch? idMatch[1] : mangaUrl;

        daftar.push({
          id: String(id),
          judul: titleMatch[1].trim(),
          sampul: imgMatch ? imgMatch[1] : "",
          URL: mangaUrl
        });
      }
    }

    kembali {
      status: benar,
      data: daftar,
      hasNextPage: html.includes("next page") || html.includes("pagination") || list.length > 0
    };
  } tangkap (kesalahan) {
    kembali {
      status: salah,
      pesan: pesan kesalahan,
      data: []
    };
  }
}

