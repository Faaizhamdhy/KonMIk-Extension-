/**
 * 3. DAPATKAN HALAMAN / PEMBACA
 * Mengambil daftar gambar halaman untuk membaca bab
 */
fungsi asinkron getPages(mangaId, chapterId) {
  mencoba {
    const url = chapterId.startsWith("http") ? chapterId : `${BASE_URL}/chapter/${chapterId}/`;
    const res = await fetch(url, { headers });
    const html = await res.text();

    misalkan halaman = [];
    
    // Mencari tag gambar di dalam area reader (biasanya di dalam div id="readerarea" atau sejenisnya)
    const imgRegex = /<img[^>]+src="([^"]+)"[^>]*>/gi;
    biarkan cocok;

    selama ((match = imgRegex.exec(html)) !== null) {
      const imgSrc = match[1];
      // Filter agar hanya mengambil gambar komik (biasanya berisi CDN gambar doujindesu)
      jika (imgSrc && !imgSrc.includes("logo") && !imgSrc.includes("icon") && !imgSrc.includes("avatar")) {
        halaman.push(imgSrc);
      }
    }

    kembali {
      status: benar,
      data: halaman
    };
  } tangkap (kesalahan) {
    kembali {
      status: salah,
      pesan: pesan kesalahan,
      data: []
    };
  }
}

